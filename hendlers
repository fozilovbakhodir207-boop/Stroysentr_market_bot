 let savedImageURL = ""; // Avtomatik yaratilgan rasm manzili shu o'zgaruvchida saqlanadi

async function autoUploadImage(input) {
    if (!input.files || !input.files[0]) return;

    let file = input.files[0];
    let formData = new FormData();
    formData.append("file", file);

    document.getElementById("upload-status").innerText = "Rasm papkaga yuklanmoqda...";
    document.getElementById("preview-area").style.display = "block";

    try {
        let response = await fetch("/api/upload", {
            method: "POST",
            body: formData
        });

        let data = await response.json();

        if (data.status === "success") {
            savedImageURL = data.url; // 'uploads/filename.jpg' korinishidagi manzil
            
            // Ekran shaklida preview ko'rsatish
            document.getElementById("uploaded-img-preview").src = savedImageURL;
            document.getElementById("upload-status").innerText = "✅ Rasm avtomatik papkaga joylandi!";
        } else {
            alert("Rasm yuklashda xatolik yuz berdi!");
        }
    } catch (err) {
        console.error(err);
        alert("Server bilan bog'lanishda xatolik!");
    }
}
